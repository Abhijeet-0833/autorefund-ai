{
  "name": "ai-refund-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema=prisma/schema.prisma && next dev",
    "build": "prisma generate --schema=prisma/schema.postgresql.prisma && next build",
    "build:pg": "prisma generate --schema=prisma/schema.postgresql.prisma && next build",
    "build:sqlite": "prisma generate --schema=prisma/schema.prisma && next build",
    "postinstall": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "start": "next start",
    "lint": "next lint",
    "test": "prisma generate --schema=prisma/schema.prisma && vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx prisma/seed.ts",
    "db:push:pg": "prisma db push --schema=prisma/schema.postgresql.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "openai": "^4.76.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "pdfkit": "^0.20.2",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
