# Database Connection
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Supabase Transaction Pooler - Port 6543):
# DATABASE_URL="postgresql://USER:PASSWORD@TRANSACTION_POOLER_HOST:6543/postgres?pgbouncer=true"

# Production PostgreSQL Direct / Migration Connection (Supabase Session Pooler - Port 5432):
# DIRECT_URL="postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres"

# OpenAI API Key (required for real LLM tool orchestrations; fallback engine works without it)
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

